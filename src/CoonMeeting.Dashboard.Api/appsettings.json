{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "_secrets": [
    "Every value left empty below is a SECRET and must come from the environment, never from",
    "this file. Set as env vars: Session__SigningKey, CoonMeeting__AdminProvisioningKey. The",
    "app refuses to start without them."
  ],
  "Database": {
    "FilePath": "data/dashboard.db"
  },
  "Session": {
    "Issuer": "coon-meeting-dashboard",
    "Audience": "coon-meeting-dashboard-users",
    "SigningKey": "",
    "TtlHours": 12
  },
  "CoonMeeting": {
    "ApiBaseUrl": "http://localhost:5029",
    "AdminProvisioningKey": ""
  },
  "Frontend": {
    "BaseUrl": "http://localhost:5174"
  }
}
